#!/usr/bin/env sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ "${CODEBATTLE_DEVCONTAINER:-}" = "1" ]; then
  cd "$repo_dir"
  exec "$@"
fi

compose() {
  docker compose \
    --project-name codebattle-devcontainer \
    --project-directory "$repo_dir" \
    --file "$repo_dir/compose.yml" \
    "$@"
}

# Read only this non-secret setting; never source the host .env as shell code.
if [ -z "${CODEBATTLE_DEV_RUNNER_LANGS:-}" ] && [ -f "$repo_dir/.env" ]; then
  CODEBATTLE_DEV_RUNNER_LANGS=$(awk '
    /^[[:space:]]*CODEBATTLE_DEV_RUNNER_LANGS[[:space:]]*=/ {
      sub(/^[^=]*=/, ""); value = $0
    }
    END {
      gsub(/^[[:space:]"\047]+|[[:space:]"\047]+$/, "", value)
      print value
    }
  ' "$repo_dir/.env")
fi
CODEBATTLE_DEV_RUNNER_LANGS=${CODEBATTLE_DEV_RUNNER_LANGS:-js,python}
export CODEBATTLE_DEV_RUNNER_LANGS

# Validate before any container operations, including the startup retry.
set -f
runner_services=""
for lang in $(printf '%s' "$CODEBATTLE_DEV_RUNNER_LANGS" | tr ',' ' '); do
  case "$lang" in
    clojure|cpp|csharp|dart|dlang|elixir|golang|java|js|kotlin|php|python|ruby|rust|swift|ts|zig)
      runner_services="$runner_services runner-$lang"
      ;;
    *)
      echo "bin/dev: unsupported runner language: $lang" >&2
      exit 1
      ;;
  esac
done
if [ -z "$runner_services" ]; then
  echo "bin/dev: CODEBATTLE_DEV_RUNNER_LANGS must contain at least one language." >&2
  exit 1
fi

if [ "${1:-}" = "--pull-runners" ]; then
  set -- $runner_services
  compose pull "$@"
  exit
fi

up() {
  # runner_services contains only validated service names, split intentionally.
  set -- app $runner_services
  compose up --detach "$@"
}

app_running() {
  [ -n "$(compose ps --quiet --status running app 2>/dev/null)" ]
}

if app_running; then
  app_was_running=1
else
  app_was_running=0
  "$repo_dir/.devcontainer/preflight"
fi

# An editor's devcontainer support and bin/dev both drive the same Compose
# project, so `up` regularly recreates the container. Docker occasionally still
# holds the published ports of the container it just removed; one retry after
# dropping the stale container clears that.
if ! up; then
  echo "bin/dev: 'docker compose up' failed, retrying once without the stale container..." >&2
  compose rm --stop --force app >/dev/null 2>&1 || true
  sleep 2
  up
fi

# Compose resolves the `.:/workspace` bind mount against its project directory.
# A devcontainer tool that picks .devcontainer/ instead of the repository root
# mounts the wrong tree, which is otherwise only visible as missing source files.
if [ "$app_was_running" -eq 0 ] && ! compose exec --no-TTY app test -f /workspace/mix.exs; then
  cat >&2 <<'EOF'
bin/dev: /workspace in the dev container is not the repository root.

The container was started with a Compose project directory other than the
repository root, so `.:/workspace` resolved to the wrong host directory. Reset
it with:

  make dev-down && make dev-up

EOF
  exit 1
fi

if [ -t 0 ]; then
  exec docker compose \
    --project-name codebattle-devcontainer \
    --project-directory "$repo_dir" \
    --file "$repo_dir/compose.yml" \
    exec app "$@"
else
  exec docker compose \
    --project-name codebattle-devcontainer \
    --project-directory "$repo_dir" \
    --file "$repo_dir/compose.yml" \
    exec --no-TTY app "$@"
fi
