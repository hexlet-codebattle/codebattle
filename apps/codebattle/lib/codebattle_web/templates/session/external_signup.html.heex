<div class="cb-container-fluid auth-container cb-d-flex cb-align-center cb-justify-center cb-vh-100">
  <div class="cup" />
  <div id="externalBackGround" class="rotating-background"></div>
  <div class="auth-card cb-text-center cb-p-4">
    <div class="battle-title cb-mb-3">
      {Application.get_env(:codebattle, :external)[:app_name]}
    </div>

    <h1 class="main-title text-purple cb-mb-3">
      {raw(Application.get_env(:codebattle, :external)[:app_slogan])}
    </h1>

    <div class="login-description cb-text-light cb-mb-4">
      {Application.get_env(:codebattle, :external)[:app_signup_description]}
    </div>

    <%= link to: Application.get_env(:codebattle, :free_users_redirect_url), class: "cb-btn btn-yellow cb-mb-4" do %>
      {Application.get_env(:codebattle, :external)[:app_signup_button]}
    <% end %>

    <%= form_for @conn, Routes.session_path(@conn, :delete), [as: :session, method: :delete], fn _f -> %>
      <button type="submit" class="cb-btn btn-gray">
        {Application.get_env(:codebattle, :external)[:app_relogin_button]}
      </button>
    <% end %>
  </div>
</div>
