<% external = Application.get_env(:codebattle, :external, []) %>
<div class="ext">
  <div class="ext-cup"></div>
  <div id="externalBackGround" class="rotating-background"></div>
  <div class="ext-card">
    <div class="ext-name">{external[:app_name]}</div>
    <h1 class="ext-slogan">{raw(external[:app_slogan])}</h1>
    <div class="ext-description">{external[:app_signup_description]}</div>
    <a class="ext-btn" href={Application.get_env(:codebattle, :free_users_redirect_url)}>
      {external[:app_signup_button]}
    </a>
    <%= form_for @conn, Routes.session_path(@conn, :delete), [as: :session, method: :delete], fn _f -> %>
      <button type="submit" class="ext-btn ext-btn--gray">{external[:app_relogin_button]}</button>
    <% end %>
  </div>
</div>
