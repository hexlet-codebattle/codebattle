<div class="cb-container cb-d-flex cb-flex-column cb-align-center cb-justify-center cb-vh-100">
  <div class="cb-p-4">
    <%= if header = Codebattle.Customization.get("login_header") do %>
      <div class="cb-mb-3">
        {raw(header)}
      </div>
    <% end %>

    <%= if body = Codebattle.Customization.get("login_body") do %>
      <div class="cb-mb-3">
        {raw(body)}
      </div>
    <% end %>
  </div>
  <div>
    <button
      class="cb-btn cb-btn-info cb-w-100"
      data-csrf={csrf_token()}
      data-method="post"
      data-to="/games/training"
    >
      {gettext("Try simple battle")}
    </button>
  </div>

  <div class="cb-w-100" style="max-width: 400px;">
    <%= form_for @conn, Routes.session_path(@conn, :create), [as: :session], fn f -> %>
      <div class="cb-mb-3">
        {label(f, :name, gettext("Name"), class: "form-label")}
        {text_input(f, :name, class: "cb-form-control", placeholder: gettext("Enter your name"))}
      </div>
      <div class="cb-mb-3">
        {label(f, :password, gettext("Password"), class: "form-label")}
        {password_input(f, :password,
          class: "cb-form-control",
          placeholder: gettext("Enter your password")
        )}
      </div>
      <div>
        {submit(gettext("Log in"), class: "cb-btn cb-btn-primary cb-w-100")}
      </div>
    <% end %>
  </div>
</div>
