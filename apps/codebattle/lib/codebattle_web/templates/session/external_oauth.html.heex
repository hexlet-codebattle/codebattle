<div class="cb-container-fluid auth-container cb-d-flex cb-align-center cb-justify-center cb-vh-100">
  <div class="cup" />
  <div id="externalBackGround" class="rotating-background"></div>
  <div class="auth-card cb-text-center cb-p-4">
    <div class="battle-title cb-mb-3">
      {Application.get_env(:codebattle, :external)[:app_name]}
    </div>

    <h1 class="main-title text-purple cb-mb-3">
      {raw(Application.get_env(:codebattle, :external)[:app_slogan])}
    </h1>

    <div class="login-description cb-text-light cb-mb-4">
      {Application.get_env(:codebattle, :external)[:app_login_description]}
    </div>

    <button class="cb-btn btn-yellow" id="externalLoginBtn">
      {Application.get_env(:codebattle, :external)[:app_login_button]}
    </button>
  </div>
</div>

<%= if body = Codebattle.Customization.get("external_oauth_body") do %>
  <div class="cb-mb-3">
    {raw(body)}
  </div>
<% end %>
