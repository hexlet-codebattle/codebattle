<div class="cb-container cb-d-flex cb-flex-column cb-align-center cb-justify-center cb-vh-100">
  <div class="cb-p-4">
    <% header =
      Codebattle.Customization.get("waiting_header") ||
        "<center><h1>Waiting</h1></center>" %>
    <div class="cb-mb-3">
      {raw(header)}
    </div>

    <% body =
      Codebattle.Customization.get("waiting_body") ||
        "Please wait for the next tournament to start." %>
    <div class="cb-mb-3">
      {raw(body)}
    </div>
    <div>
      <button
        class="cb-btn btn-outline-red cb-text-uppercase cb-mt-3 cb-p-3 cb-rounded-lg"
        data-csrf={csrf_token()}
        data-method="post"
        data-to="/games/training"
      >
        {gettext("Try simple battle")}
      </button>
    </div>
  </div>
</div>
