<div class="bare">
  <div class="bare-custom">
    {raw(Codebattle.Customization.get("waiting_header") || "<h1>Waiting</h1>")}
  </div>
  <div class="bare-custom">
    {raw(
      Codebattle.Customization.get("waiting_body") ||
        "Please wait for the next tournament to start."
    )}
  </div>
  <form method="post" action="/games/training">
    <input type="hidden" name="_csrf_token" value={csrf_token()} />
    <button type="submit" class="bare-btn">{gettext("Try simple battle")}</button>
  </form>
</div>
