<div class="cb-container-xl cb-bg-panel cb-shadow-sm cb-rounded cb-py-4 cb-mt-3">
  <h1 class="cb-text-center cb-text-white">Duplicate Tournament</h1>
  <p class="cb-text-center cb-text">
    Enter a tournament ID and the number of copies to create.
    Each copy will have the same settings; token-based tournaments get fresh tokens.
  </p>
  <div class="cb-row cb-justify-center cb-mt-4">
    <div class="cb-col-md-6">
      <form action={Routes.admin_tournament_duplicator_path(@conn, :create)} method="post">
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <div class="cb-form-group cb-mb-3">
          <label class="cb-text" for="tournament_id">Tournament ID</label>
          <input
            type="number"
            name="tournament_id"
            id="tournament_id"
            class="cb-form-control cb-bg-highlight-panel cb-text cb-border-color"
            required
            min="1"
          />
        </div>
        <div class="cb-form-group cb-mb-3">
          <label class="cb-text" for="count">Number of copies</label>
          <input
            type="number"
            name="count"
            id="count"
            class="cb-form-control cb-bg-highlight-panel cb-text cb-border-color"
            required
            min="1"
            max="100"
            value="20"
          />
        </div>
        <button type="submit" class="cb-btn cb-btn-success cb-text-white cb-rounded">
          Duplicate
        </button>
      </form>
    </div>
  </div>
</div>
