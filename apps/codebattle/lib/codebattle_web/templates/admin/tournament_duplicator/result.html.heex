<div class="cb-container-xl cb-bg-panel cb-shadow-sm cb-rounded cb-py-4 cb-mt-3">
  <h1 class="cb-text-center cb-text-white">Duplicated Tournaments</h1>
  <p class="cb-text-center cb-text">
    Created {length(@tournaments)} tournament(s) from
    <strong class="cb-text-white">{@source.name}</strong>
    (ID: {@source.id})
  </p>
  <div class="cb-table-responsive cb-mt-4">
    <table class="cb-table cb-table-sm">
      <thead class="cb-text">
        <tr>
          <th class="cb-border-color cb-border-bottom">ID</th>
          <th class="cb-border-color cb-border-bottom">Name</th>
          <th class="cb-border-color cb-border-bottom">Access Type</th>
          <th class="cb-border-color cb-border-bottom">Access Token</th>
          <th class="cb-border-color cb-border-bottom">Starts At</th>
          <th class="cb-border-color cb-border-bottom">Link</th>
        </tr>
      </thead>
      <tbody>
        <%= for tournament <- @tournaments do %>
          <tr>
            <td class="cb-align-middle cb-text-white cb-border-color">{tournament.id}</td>
            <td class="cb-align-middle cb-text-white cb-border-color">{tournament.name}</td>
            <td class="cb-align-middle cb-text-white cb-border-color">
              {tournament.access_type}
            </td>
            <td class="cb-align-middle cb-text-white cb-border-color">
              {tournament.access_token || "—"}
            </td>
            <td class="cb-align-middle cb-text-white cb-border-color">{tournament.starts_at}</td>
            <td class="cb-align-middle cb-border-color">
              <a
                href={"/tournaments/#{tournament.id}"}
                class="cb-btn cb-btn-sm cb-btn-outline-secondary cb-rounded"
                target="_blank"
              >
                Open
              </a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="cb-mt-3">
    <a
      href={Routes.admin_tournament_duplicator_path(@conn, :new)}
      class="cb-btn cb-btn-secondary cb-rounded"
    >
      Duplicate more
    </a>
  </div>
</div>
