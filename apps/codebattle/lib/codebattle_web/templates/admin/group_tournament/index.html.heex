<div class="cb-container-xl cb-bg-panel cb-shadow-sm cb-rounded cb-py-4 cb-mt-3">
  <h1 class="cb-text-center cb-text-white">Group Tournaments</h1>
  {link("Create new group tournament",
    to: Routes.admin_group_tournament_path(@conn, :new),
    class: "cb-btn cb-btn-success cb-text-white cb-mt-2 cb-rounded"
  )}
  <div class="cb-table-responsive cb-mt-4">
    <table class="cb-table cb-table-sm">
      <thead class="cb-text">
        <tr>
          <th class="cb-border-color cb-border-bottom">id</th>
          <th class="cb-border-color cb-border-bottom">name</th>
          <th class="cb-border-color cb-border-bottom">slug</th>
          <th class="cb-border-color cb-border-bottom">group_task</th>
          <th class="cb-border-color cb-border-bottom">state</th>
          <th class="cb-border-color cb-border-bottom">players</th>
          <th class="cb-border-color cb-border-bottom">
            <a
              href={
                Routes.admin_group_tournament_path(@conn, :index,
                  sort_by: "starts_at",
                  sort_dir: sort_link_dir(@sort_by, @sort_dir, :starts_at)
                )
              }
              class="cb-text-decoration-none cb-text"
            >
              starts_at{sort_arrow(@sort_by, @sort_dir, :starts_at)}
            </a>
          </th>
          <th class="cb-border-color cb-border-bottom">
            <a
              href={
                Routes.admin_group_tournament_path(@conn, :index,
                  sort_by: "finished_at",
                  sort_dir: sort_link_dir(@sort_by, @sort_dir, :finished_at)
                )
              }
              class="cb-text-decoration-none cb-text"
            >
              finished_at{sort_arrow(@sort_by, @sort_dir, :finished_at)}
            </a>
          </th>
        </tr>
      </thead>
      <tbody>
        <%= for group_tournament <- @group_tournaments do %>
          <tr>
            <td class="cb-align-middle cb-text-white cb-border-color">{group_tournament.id}</td>
            <td class="cb-align-middle cb-text-white cb-border-color">{group_tournament.name}</td>
            <td class="cb-align-middle cb-text-white cb-border-color">{group_tournament.slug}</td>
            <td class="cb-align-middle cb-text-white cb-border-color">
              {group_tournament.group_task && group_tournament.group_task.slug}
            </td>
            <td class="cb-align-middle cb-text-white cb-border-color">
              {group_tournament.state}
            </td>
            <td class="cb-align-middle cb-text-white cb-border-color">
              {group_tournament.players_count}
            </td>
            <td class="cb-align-middle cb-text-white cb-border-color">
              {format_datetime(group_tournament.starts_at)}
            </td>
            <td class="cb-align-middle cb-text-white cb-border-color">
              {format_datetime(group_tournament.finished_at)}
            </td>
            <td class="cb-align-middle cb-text-nowrap cb-border-color">
              <div class="cb-d-flex">
                {link("Show",
                  to: Routes.admin_group_tournament_path(@conn, :show, group_tournament),
                  class: "cb-btn cb-btn-sm cb-btn-outline-secondary cb-rounded"
                )}
                {link("Edit",
                  to: Routes.admin_group_tournament_path(@conn, :edit, group_tournament),
                  class: "cb-btn cb-btn-sm cb-btn-outline-secondary cb-rounded cb-ml-2"
                )}
                {link("Start",
                  to: Routes.admin_group_tournament_path(@conn, :start, group_tournament),
                  method: :post,
                  data: [confirm: "Start this group tournament now?"],
                  class: "cb-btn cb-btn-sm cb-btn-success cb-text-white cb-rounded cb-ml-2"
                )}
                {link("Delete",
                  to: Routes.admin_group_tournament_path(@conn, :delete, group_tournament),
                  method: :delete,
                  data: [confirm: "Are you sure you want to delete this group tournament?"],
                  class: "cb-btn cb-btn-sm cb-btn-outline-danger cb-rounded cb-ml-2"
                )}
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
