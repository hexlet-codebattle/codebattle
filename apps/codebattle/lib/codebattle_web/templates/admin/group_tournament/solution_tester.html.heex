<div class="cb-container-xl cb-bg-panel cb-shadow-sm cb-rounded cb-py-4 cb-mt-3">
  <h1 class="cb-text-center cb-text-white cb-mb-4">
    Solution Tester — {@group_tournament.name}
  </h1>

  <div class="cb-mb-3">
    <a
      href={Routes.admin_group_tournament_path(@conn, :show, @group_tournament)}
      class="cb-btn cb-btn-outline-secondary cb-btn-sm"
    >
      Back to Tournament
    </a>
  </div>

  <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-4 cb-mb-4 cb-text-white">
    <div class="cb-row">
      <div class="cb-col-md-6">
        <div class="cb-form-group cb-mb-3">
          <label class="cb-fw-bold cb-mb-1">Token</label>
          <select
            id="token-select"
            class="cb-form-control cb-bg-dark cb-text-white cb-border-secondary"
          >
            <option value="">-- select a token --</option>
            <%= for token <- @tokens do %>
              <option value={token.token}>
                User #{token.user_id} — {String.slice(token.token, 0..15)}...
              </option>
            <% end %>
          </select>
        </div>
        <div class="cb-form-group cb-mb-3">
          <label class="cb-fw-bold cb-mb-1">Or paste token manually</label>
          <input
            id="token-input"
            type="text"
            class="cb-form-control cb-bg-dark cb-text-white cb-border-secondary cb-font-monospace"
            placeholder="Bearer token"
          />
        </div>
        <div class="cb-form-group cb-mb-3">
          <label class="cb-fw-bold cb-mb-1">Language</label>
          <input
            id="lang-input"
            type="text"
            value="js"
            class="cb-form-control cb-bg-dark cb-text-white cb-border-secondary cb-font-monospace"
            placeholder="js, python, elixir..."
          />
        </div>
      </div>
      <div class="cb-col-md-6">
        <div class="cb-form-group cb-mb-3">
          <label class="cb-fw-bold cb-mb-1">
            Solution (plain text, will be base64-encoded)
          </label>
          <textarea
            id="solution-input"
            rows="12"
            class="cb-form-control cb-bg-dark cb-text-white cb-border-secondary cb-font-monospace"
            style="font-size: 13px; resize: vertical;"
            placeholder="Paste your solution code here..."
          ></textarea>
        </div>
      </div>
    </div>

    <button id="submit-btn" class="cb-btn cb-btn-primary cb-mt-2">
      Submit Solution
    </button>

    <div id="result-panel" class="cb-mt-4" style="display: none;">
      <h5>Response</h5>
      <pre
        id="result-output"
        class="cb-bg-dark cb-text-white cb-p-3 cb-border cb-border-secondary cb-rounded-sm"
        style="white-space: pre-wrap; font-size: 13px;"
      ></pre>
    </div>
  </div>
</div>

<script>
  document.getElementById("submit-btn").addEventListener("click", async () => {
    const tokenFromSelect = document.getElementById("token-select").value;
    const tokenFromInput = document.getElementById("token-input").value.trim();
    const token = tokenFromInput || tokenFromSelect;
    const lang = document.getElementById("lang-input").value.trim();
    const solutionText = document.getElementById("solution-input").value;
    const resultPanel = document.getElementById("result-panel");
    const resultOutput = document.getElementById("result-output");

    if (!token || !solutionText) {
      resultPanel.style.display = "block";
      resultOutput.textContent = "Error: token and solution are required";
      return;
    }

    const solution = btoa(unescape(encodeURIComponent(solutionText)));

    const btn = document.getElementById("submit-btn");
    btn.disabled = true;
    btn.textContent = "Submitting...";

    try {
      const response = await fetch("/api/v1/group_task_solutions", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": "Bearer " + token
        },
        body: JSON.stringify({ lang, solution })
      });

      const data = await response.json();
      resultPanel.style.display = "block";
      resultOutput.textContent = response.status + " " + response.statusText + "\n\n" + JSON.stringify(data, null, 2);
    } catch (err) {
      resultPanel.style.display = "block";
      resultOutput.textContent = "Request failed: " + err.message;
    } finally {
      btn.disabled = false;
      btn.textContent = "Submit Solution";
    }
  });
</script>
