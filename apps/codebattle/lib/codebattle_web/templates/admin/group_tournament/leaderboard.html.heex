<% rounds_count = @group_tournament.rounds_count || 0
rounds = if rounds_count > 0, do: Enum.to_list(1..rounds_count), else: []

round_label = fn
  1 -> "Seed"
  r -> "R#{r - 1}"
end

cell_for = fn entry, r ->
  rounds_map = entry[:rounds] || %{}
  Map.get(rounds_map, r) || Map.get(rounds_map, to_string(r))
end

place_class = fn
  1 -> "cb-gold-place-bg"
  2 -> "cb-silver-place-bg"
  3 -> "cb-bronze-place-bg"
  _ -> ""
end

view_path = fn view ->
  base = Routes.admin_group_tournament_path(@conn, :leaderboard, @group_tournament)

  case view do
    :rating -> base
    {:round, n} -> base <> "?view=" <> Integer.to_string(n)
  end
end

tab_class = fn active ->
  if active,
    do: "cb-btn cb-btn-sm cb-btn-light cb-text-dark cb-fw-bold cb-mr-2 cb-mb-2",
    else: "cb-btn cb-btn-sm cb-btn-outline-light cb-mr-2 cb-mb-2"
end

slices_for_round = fn round_number ->
  @leaderboard
  |> Enum.flat_map(fn entry ->
    cell = cell_for.(entry, round_number)

    case cell do
      %{slice_index: idx} when is_integer(idx) ->
        [
          {idx,
           %{
             user_id: entry[:user_id],
             name: entry[:name] || "##{entry[:user_id]}",
             clan: entry[:clan],
             place: cell[:place],
             score: cell[:score] || 0
           }}
        ]

      _ ->
        []
    end
  end)
  |> Enum.group_by(fn {idx, _} -> idx end, fn {_, p} -> p end)
  |> Enum.map(fn {idx, players} ->
    sorted =
      Enum.sort_by(players, fn p ->
        {if(is_integer(p.place), do: p.place, else: 999_999), -(p.score || 0), p.user_id}
      end)

    {idx, sorted}
  end)
  |> Enum.sort_by(fn {idx, _} -> idx end)
end %>
<head>
  <meta http-equiv="refresh" content="5" />
</head>
<div class="cb-container-xl cb-bg-panel cb-shadow-sm cb-rounded cb-py-4 cb-mt-3">
  <div class="cb-d-flex cb-justify-between cb-align-center cb-mb-3">
    <h1 class="cb-text-white cb-mb-0">Leaderboard — {@group_tournament.name}</h1>
    <div>
      {link("Back",
        to: Routes.admin_group_tournament_path(@conn, :show, @group_tournament),
        class: "cb-btn cb-btn-outline-secondary cb-rounded"
      )}
    </div>
  </div>

  <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-3 cb-mb-3 cb-text-white cb-d-flex cb-flex-wrap cb-align-center">
    <div class="cb-mr-4"><strong>State:</strong> {@group_tournament.state}</div>
    <div class="cb-mr-4">
      <strong>Round:</strong> {@group_tournament.current_round_position}/{rounds_count}
    </div>
    <div class="cb-mr-4"><strong>Players:</strong> {@group_tournament.players_count}</div>
    <div class="cb-mr-4">
      <strong>Visible to players:</strong> {inspect(@group_tournament.show_leaderboard)}
    </div>
    <div class="cb-ml-auto cb-text-muted cb-small">auto-refresh every 5s</div>
  </div>

  <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-3 cb-mb-3">
    <div class="cb-d-flex cb-flex-wrap">
      {link("Rating", to: view_path.(:rating), class: tab_class.(@view == :rating))}
      <%= for r <- rounds do %>
        {link(round_label.(r),
          to: view_path.({:round, r}),
          class: tab_class.(@view == {:round, r})
        )}
      <% end %>
    </div>
  </div>

  <%= cond do %>
    <% Enum.empty?(@leaderboard) -> %>
      <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-4 cb-text-center cb-text-muted">
        No leaderboard data yet.
      </div>
    <% @view == :rating -> %>
      <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-3">
        <div class="cb-table-responsive">
          <table class="cb-table cb-table-sm cb-text-light">
            <thead>
              <tr>
                <th class="cb-border-0 cb-fw-light">#</th>
                <th class="cb-border-0 cb-fw-light">Player</th>
                <th class="cb-border-0 cb-fw-light">Clan</th>
                <th class="cb-border-0 cb-fw-light cb-text-center">Slice</th>
                <%= for r <- rounds do %>
                  <th class="cb-border-0 cb-fw-light cb-text-center">{round_label.(r)}</th>
                <% end %>
                <th class="cb-border-0 cb-fw-light cb-text-center">Total</th>
              </tr>
            </thead>
            <tbody>
              <%= for {entry, index} <- Enum.with_index(@leaderboard, 1) do %>
                <tr class={"cb-fw-bold #{place_class.(index)}"}>
                  <td class="cb-align-middle">{index}</td>
                  <td class="cb-align-middle cb-text-white">
                    <span title={entry[:name] || "##{entry[:user_id]}"}>
                      {entry[:name] || "##{entry[:user_id]}"}
                    </span>
                    <%= if entry[:state] == "left" do %>
                      <span class="cb-badge cb-badge-secondary cb-ml-2">Left</span>
                    <% end %>
                  </td>
                  <td class="cb-align-middle cb-text-white">{entry[:clan] || "—"}</td>
                  <td class="cb-align-middle cb-text-center cb-text-white">
                    <%= if is_integer(entry[:slice_index]) do %>
                      {entry[:slice_index] + 1}
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <%= for r <- rounds do %>
                    <% cell = cell_for.(entry, r) %>
                    <td class="cb-align-middle cb-text-center cb-text-white">
                      <%= if cell do %>
                        <span class="cb-fw-bold">{cell[:score] || 0}</span>
                        <%= if is_integer(cell[:place]) do %>
                          <span class="cb-small cb-ml-1">(#{cell[:place]})</span>
                        <% end %>
                      <% else %>
                        <span class="cb-text-muted">—</span>
                      <% end %>
                    </td>
                  <% end %>
                  <td class="cb-align-middle cb-text-center cb-text-white cb-fw-bold">
                    {entry[:total_score] || 0}
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% match?({:round, _}, @view) -> %>
      <% {:round, round_number} = @view %>
      <% slices = slices_for_round.(round_number) %>
      <%= if slices == [] do %>
        <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-4 cb-text-center cb-text-muted">
          No data yet for {round_label.(round_number)}.
        </div>
      <% else %>
        <div class="cb-d-flex cb-flex-wrap" style="gap: 1rem;">
          <%= for {slice_index, players} <- slices do %>
            <div
              class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-2"
              style="min-width: 22rem; flex: 1 1 22rem;"
            >
              <div class="cb-d-flex cb-justify-between cb-border-bottom cb-border-color cb-pb-1 cb-mb-2 cb-px-2 cb-text-white">
                <span class="cb-fw-bold">Group {slice_index + 1}</span>
                <span class="cb-text-muted cb-small">{length(players)} players</span>
              </div>
              <table class="cb-table cb-table-sm cb-text-light cb-mb-0">
                <thead>
                  <tr>
                    <th class="cb-border-0 cb-fw-light cb-p-1">#</th>
                    <th class="cb-border-0 cb-fw-light cb-p-1">Player</th>
                    <th class="cb-border-0 cb-fw-light cb-p-1">Clan</th>
                    <th class="cb-border-0 cb-fw-light cb-p-1 cb-text-right">Score</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for {p, idx} <- Enum.with_index(players, 1) do %>
                    <tr class={"cb-fw-bold #{place_class.(p.place || 0)}"}>
                      <td class="cb-p-1 cb-align-middle cb-text-white">{p.place || idx}</td>
                      <td class="cb-p-1 cb-align-middle cb-text-white" title={p.name}>
                        {p.name}
                      </td>
                      <td class="cb-p-1 cb-align-middle cb-text-white">{p.clan || "—"}</td>
                      <td class="cb-p-1 cb-align-middle cb-text-right cb-text-white cb-fw-bold">
                        {p.score}
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      <% end %>
  <% end %>
</div>
