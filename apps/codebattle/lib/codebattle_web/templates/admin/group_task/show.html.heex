<div class="cb-container-xl cb-bg-panel cb-shadow-sm cb-rounded cb-py-4 cb-mt-3">
  <h1 class="cb-text-center cb-text-white">
    <span>{@group_task.slug}</span>
  </h1>

  <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-4 cb-mb-4 cb-text-white">
    <div class="cb-row">
      <div class="cb-col-md-6">
        <p><strong>ID:</strong> {@group_task.id}</p>
        <p><strong>Slug:</strong> {@group_task.slug}</p>
      </div>
      <div class="cb-col-md-6">
        <p><strong>Time To Solve:</strong> {@group_task.time_to_solve_sec} sec</p>
        <p><strong>Created At:</strong> {format_datetime(@group_task.inserted_at)}</p>
        <p><strong>Runner URL:</strong> {@group_task.runner_url || "none"}</p>
      </div>
    </div>
  </div>

  <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-4 cb-mb-4">
    <div class="cb-d-flex cb-justify-between cb-align-center cb-mb-3">
      <h3 class="cb-text-white cb-mb-0">Latest Solutions</h3>
      <span class="cb-text">showing {length(@solutions)} most recent</span>
    </div>

    <div class="cb-table-responsive">
      <table class="cb-table cb-table-sm">
        <thead class="cb-text">
          <tr>
            <th class="cb-border-color cb-border-bottom">inserted_at</th>
            <th class="cb-border-color cb-border-bottom">user_id</th>
            <th class="cb-border-color cb-border-bottom">user</th>
            <th class="cb-border-color cb-border-bottom">lang</th>
            <th class="cb-border-color cb-border-bottom">solution</th>
            <th class="cb-border-color cb-border-bottom"></th>
          </tr>
        </thead>
        <tbody>
          <%= for solution <- @solutions do %>
            <tr>
              <td class="cb-text-white cb-border-color">
                {format_datetime(solution.inserted_at)}
              </td>
              <td class="cb-text-white cb-border-color">{solution.user_id}</td>
              <td class="cb-text-white cb-border-color">{solution.user && solution.user.name}</td>
              <td class="cb-text-white cb-border-color">{solution.lang}</td>
              <td class="cb-text-white cb-border-color">
                <pre class="cb-mb-0 cb-text-white"><code>{solution.solution}</code></pre>
              </td>
              <td class="cb-text-nowrap cb-border-color">
                {link("Edit",
                  to:
                    Routes.edit_group_task_solution_path(
                      @conn,
                      :edit_solution,
                      @group_task,
                      solution.id
                    ),
                  class: "cb-btn cb-btn-sm cb-btn-outline-secondary cb-rounded"
                )}
                {link("Delete",
                  to:
                    Routes.group_task_solution_path(
                      @conn,
                      :delete_solution,
                      @group_task,
                      solution.id
                    ),
                  method: :delete,
                  data: [confirm: "Are you sure you want to delete this solution?"],
                  class: "cb-btn cb-btn-sm cb-btn-outline-danger cb-rounded cb-ml-2"
                )}
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="cb-d-flex cb-mt-4">
    {link("Edit",
      to: Routes.group_task_path(@conn, :edit, @group_task),
      class: "cb-btn cb-btn-outline-secondary cb-rounded"
    )}
    {link("Back",
      to: Routes.group_task_path(@conn, :index),
      class: "cb-btn cb-btn-link cb-text cb-ml-auto"
    )}
  </div>
</div>
