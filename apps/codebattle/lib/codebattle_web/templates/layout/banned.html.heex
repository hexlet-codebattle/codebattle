<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link
      href="/assets/images/favicons/favicon.svg?v=codebattle-logo"
      rel="icon"
      sizes="any"
      type="image/svg+xml"
    />
    <title>{Application.get_env(:codebattle, :app_title)}</title>
    {render("_server_styles.html", assigns)}
  </head>
  <body>
    <div class="bare">
      <div class="bare-custom">
        {raw(
          Codebattle.Customization.get("banned_header") ||
            "<h1>You are banned from the site.</h1>"
        )}
      </div>
      <div class="bare-custom">
        {raw(
          Codebattle.Customization.get("banned_body") ||
            "Please contact the administrator for more information."
        )}
      </div>
    </div>
  </body>
</html>
