<!DOCTYPE html>
<html lang={Gettext.get_locale(CodebattleWeb.Gettext)}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    {google_fonts_head()}
    <link
      href="/assets/images/favicons/favicon-32x32.png?v=codebattle-logo"
      rel="icon"
      sizes="32x32"
      type="image/png"
    />
    <link href="/assets/images/favicons/favicon.ico?v=codebattle-logo" rel="shortcut icon" />
    <link
      href="/assets/images/favicons/favicon.svg?v=codebattle-logo"
      rel="icon"
      sizes="any"
      type="image/svg+xml"
    />
    <link href="/assets/images/favicons/manifest.json?v=codebattle-logo" rel="manifest" />
    {render_tags_all(assigns[:meta_tags] || %{})}
    <meta name="csrf-token" content={csrf_token_value()} />
    <script>
      // Apply the saved colour scheme before first paint (Mantine's localStorage key).
      try {
        var scheme = localStorage.getItem("mantine-color-scheme-value");
        document.documentElement.setAttribute("data-mantine-color-scheme", scheme === "light" ? "light" : "dark");
      } catch (e) {
        document.documentElement.setAttribute("data-mantine-color-scheme", "dark");
      }
    </script>
    <.inertia_head content={@inertia_head} />
    <.inertia_title>
      {assigns[:page_title] || Application.get_env(:codebattle, :app_title)}
    </.inertia_title>
    <%= if CodebattleWeb.Vite.dev?() do %>
      <script type="module">
        import { injectIntoGlobalHook } from "<%= CodebattleWeb.Frontend.dev_server_url() %>/@react-refresh";
        injectIntoGlobalHook(window);
        window.$RefreshReg$ = () => {};
        window.$RefreshSig$ = () => (type) => type;
      </script>
      <script type="module" src={"#{CodebattleWeb.Frontend.dev_server_url()}/@vite/client"}>
      </script>
      <script
        type="module"
        src={"#{CodebattleWeb.Frontend.dev_server_url()}/#{CodebattleWeb.Frontend.entry_path()}"}
      >
      </script>
    <% else %>
      <% assets = CodebattleWeb.Frontend.assets() %>
      <%= for href <- assets.css do %>
        <link rel="stylesheet" href={href} />
      <% end %>
      <%= if assets.js do %>
        <script type="module" src={assets.js}>
        </script>
      <% end %>
    <% end %>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
