<div class="cb-jumbotron cb-container cb-text-center cb-bg-panel cb-text cb-shadow-sm">
  <h2 class="cb-h2 cb-fw-normal cb-mb-4">{gettext("Game status")}</h2>
  <p class="cb-lead cb-mb-4">{"State: #{@game.state}"}</p>
  <p class="cb-lead cb-mb-4">{"Result: #{result(@game)}"}</p>
  <p class="cb-lead cb-mb-4">{"Date: #{@game.updated_at}"}</p>
</div>
