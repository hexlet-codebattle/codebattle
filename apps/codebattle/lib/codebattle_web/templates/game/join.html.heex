<div class="cb-jumbotron cb-container cb-text-center cb-bg-panel cb-text cb-shadow-sm">
  <h2 class="cb-h2 cb-fw-normal cb-mb-4">{gettext("Join the game")}</h2>
  <p class="cb-lead cb-mb-4">
    {"Player #{player_name(get_first_player(@game))} is waiting for an opponent"}
  </p>
  <button
    class="cb-btn cb-btn-outline-secondary cb-btn-md cb-px-5"
    data-csrf={csrf_token()}
    data-method="post"
    data-to={Routes.game_path(@conn, :join, @game.id)}
  >
    {gettext("Join")}
  </button>
</div>
