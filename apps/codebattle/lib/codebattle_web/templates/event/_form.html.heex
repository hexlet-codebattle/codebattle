<%= form_for(@changeset, @action, [class: "cb-col-8 cb-offset-2"], fn f -> %>
  <div class="cb-form-group">
    <div>
      <span class="cb-text-white">Slug</span>
      <span class="cb-ml-3 cb-text">Slug for an Event should be unique</span>
    </div>
    {text_input(f, :slug,
      class: "cb-form-control cb-form-control-lg cb-bg-panel cb-border-color cb-text-white",
      maxlength: "57",
      required: false
    )}
    {error_tag(f, :slug)}
  </div>
  <div class="cb-form-group">
    <div>
      <span class="cb-text-white">Title</span>
    </div>
    {text_input(f, :title,
      class: "cb-form-control cb-form-control-lg cb-bg-panel cb-border-color cb-text-white",
      maxlength: "157",
      required: false
    )}
    {error_tag(f, :title)}
  </div>
  <div class="cb-form-group">
    <div>
      <span class="cb-text-white">Description</span>
    </div>
    {textarea(f, :description,
      class: "cb-form-control cb-form-control-lg cb-bg-panel cb-border-color cb-text-white"
    )}
    {error_tag(f, :description)}
  </div>
  <div class="cb-form-group">
    {label(f, :type, class: "cb-text-white")}
    {select(f, :type, Codebattle.Event.types(),
      class: "cb-form-control cb-form-control-lg cb-bg-panel cb-border-color cb-text-white"
    )}
    {error_tag(f, :type)}
  </div>
  <div class="cb-d-flex cb-flex-column cb-justify-between cb-w-auto">
    <label class="cb-text-white">Starts at ({@user.timezone})</label>
    {datetime_local_input(f, :starts_at,
      class: "cb-form-control cb-bg-panel cb-border-color cb-text-white",
      required: true,
      value: f.params["starts_at"] || DateTime.add(DateTime.now!(@user.timezone), 5, :minute)
    )}
    {error_tag(f, :starts_at)}
  </div>
  <div class="cb-form-group">
    <div>
      <span class="cb-text-white">Ticker Text</span>
    </div>
    {text_input(f, :ticker_text,
      class: "cb-form-control cb-form-control-lg cb-bg-panel cb-border-color cb-text-white"
    )}
    {error_tag(f, :ticker_text)}
  </div>
  <div class="cb-form-group">
    <div>
      <span class="cb-text-white">Personal Tournament ID</span>
    </div>
    {number_input(f, :personal_tournament_id,
      class: "cb-form-control cb-form-control-lg cb-bg-panel cb-border-color cb-text-white"
    )}
    {error_tag(f, :personal_tournament_id)}
  </div>

  <div class="cb-mb-4">
    <h4 class="cb-text-white">Event Stages</h4>
    <div class="cb-form-group">
      <div>
        <span class="cb-text-white">Stages (JSON format)</span>
      </div>
      {textarea(f, :stages_json,
        class: "cb-form-control cb-form-control-lg cb-bg-panel cb-border-color cb-text-white",
        value: Jason.encode!(@changeset.data.stages || [], pretty: true),
        rows: 15
      )}
      {error_tag(f, :stages_json)}
      <div class="cb-alert cb-alert-info alert-dark-theme cb-mt-2">
        <p>Edit stages in JSON format. Each stage should include:</p>
        <ul>
          <li><code>slug</code>: Unique identifier for the stage</li>
          <li><code>name</code>: Display name</li>
          <li>
            <code>status</code>: One of <code>pending</code>, <code>passed</code>,
            <code>active</code>
          </li>
          <li><code>type</code>: One of <code>tournament</code>, <code>entrance</code></li>
          <li><code>playing_type</code>: One of <code>single</code>, <code>global</code></li>
          <li>
            Optional: <code>action_button_text</code>, <code>confirmation_text</code>, <code>dates</code>,
            <code>tournament_id</code>
          </li>
          <li>
            <code>tournament_meta</code>: Tournament config (<code>tournament_timeout_seconds</code>, <code>rounds_limit</code>, <code>players_limit</code>, <code>task_provider</code>, <code>task_strategy</code>, <code>task_pack_name</code>)
          </li>
          <li>
            <code>group_tournament_meta</code>: <code>%&#123;parent_id: 42&#125;</code>
            — points at a parent group tournament whose config (group_task, rounds, timeouts, require_invitation, run_on_external_platform, template_id, slicing, meta strings) is copied to each per-user tournament generated for this stage.
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="cb-d-flex">
    {submit("Save",
      phx_disable_with: "Saving...",
      class: "cb-btn cb-btn-success cb-text-white cb-mb-2 cb-rounded"
    )}
    {link("Back", to: "/admin/events", class: "cb-btn cb-btn-link cb-text cb-ml-auto")}
  </div>
<% end) %>
