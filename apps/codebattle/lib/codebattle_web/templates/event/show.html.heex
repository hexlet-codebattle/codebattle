<div class="cb-container-xl cb-bg-panel cb-shadow-sm cb-rounded cb-py-4 cb-mt-3">
  <h1 class="cb-text-center cb-text-white">
    <span>{@event.title}</span>
  </h1>

  <h3 class="cb-text-center cb-text-white cb-mt-4">Event Details</h3>
  <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-4 cb-mb-4 cb-text-white">
    <div class="cb-row">
      <div class="cb-col-md-6">
        <p><strong>Slug:</strong> {@event.slug}</p>
        <p><strong>Type:</strong> {@event.type}</p>
        <p><strong>Title:</strong> {@event.title}</p>
        <p><strong>Ticker Text:</strong> {@event.ticker_text}</p>
      </div>
      <div class="cb-col-md-6">
        <p><strong>Created By:</strong> {@event.creator_id}</p>
        <p>
          <strong>Starts At:</strong> {@event.starts_at && format_datetime(@event.starts_at)}
        </p>
        <p><strong>Personal Tournament ID:</strong> {@event.personal_tournament_id}</p>
      </div>
    </div>
    <div class="cb-row cb-mt-2">
      <div class="cb-col-12">
        <p><strong>Description:</strong></p>
        <div class="cb-p-3 cb-bg-panel cb-border-color cb-border cb-rounded">
          {@event.description}
        </div>
      </div>
    </div>
  </div>

  <h3 class="cb-text-center cb-text-white">Event Stages</h3>
  <div class="cb-bg-highlight-panel cb-border-color cb-border cb-rounded cb-p-4 cb-mb-4">
    <%= if @event.stages && length(@event.stages) > 0 do %>
      <div class="cb-table-responsive">
        <table class="cb-table cb-table-sm">
          <thead class="cb-text">
            <tr>
              <th class="cb-border-color cb-border-bottom">Name</th>
              <th class="cb-border-color cb-border-bottom">Slug</th>
              <th class="cb-border-color cb-border-bottom">Dates</th>
              <th class="cb-border-color cb-border-bottom">Status</th>
              <th class="cb-border-color cb-border-bottom">Type</th>
              <th class="cb-border-color cb-border-bottom">Playing Type</th>
              <th class="cb-border-color cb-border-bottom">Button Text</th>
              <th class="cb-border-color cb-border-bottom">Confirmation Text</th>
              <th class="cb-border-color cb-border-bottom">Tournament ID</th>
              <th class="cb-border-color cb-border-bottom">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= for stage <- @event.stages do %>
              <tr>
                <td class="cb-text-white cb-border-color">{stage.name}</td>
                <td class="cb-text-white cb-border-color">{stage.slug}</td>
                <td class="cb-text-white cb-border-color">{stage.dates}</td>
                <td class="cb-border-color">
                  <span class={"cb-badge #{case stage.status do
                      :pending -> "cb-bg-warning cb-text-dark"
                      :active -> "cb-bg-success"
                      :passed -> "cb-bg-secondary"
                      _ -> "cb-bg-light cb-text-dark"
                    end}"}>
                    {stage.status}
                  </span>
                </td>
                <td class="cb-border-color">
                  <span class={"cb-badge #{if stage.type == :tournament, do: "cb-bg-primary", else: "cb-bg-info cb-text-dark"}"}>
                    {stage.type}
                  </span>
                </td>
                <td class="cb-border-color">
                  <span class={"cb-badge #{if stage.playing_type == :single, do: "cb-bg-dark", else: "cb-bg-secondary"}"}>
                    {stage.playing_type}
                  </span>
                </td>
                <td class="cb-text-white cb-border-color">{stage.action_button_text}</td>
                <td class="cb-text-white cb-border-color">
                  <%= if stage.confirmation_text && String.length(stage.confirmation_text) > 200 do %>
                    {String.slice(stage.confirmation_text, 0, 200)}
                    <span class="cb-text">...</span>
                  <% else %>
                    {stage.confirmation_text}
                  <% end %>
                </td>
                <td class="cb-text-white cb-border-color">{stage.tournament_id}</td>
                <td class="cb-border-color">
                  <div class="cb-d-flex cb-flex-column gap-1">
                    {link("Enroll All Users",
                      to:
                        Routes.event_enroll_all_path(@conn, :enroll_all, @event,
                          stage_slug: stage.slug
                        ),
                      method: :post,
                      data: [confirm: "Enroll all non-bot users into stage \"#{stage.slug}\"?"],
                      class: "cb-btn cb-btn-sm cb-btn-warning cb-rounded cb-text-nowrap"
                    )}
                    {link("Calculate places",
                      to:
                        Routes.event_calculate_places_path(@conn, :calculate_places, @event,
                          stage_slug: stage.slug
                        ),
                      method: :post,
                      data: [
                        confirm:
                          "Recalculate place_in_total/category for stage \"#{stage.slug}\"?"
                      ],
                      class: "cb-btn cb-btn-sm cb-btn-info cb-rounded cb-text-nowrap cb-mt-1"
                    )}
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="cb-alert cb-alert-info alert-dark-theme cb-mb-0">
        No stages configured for this event yet. Event stages will be automatically configured when needed.
      </div>
    <% end %>
  </div>

  <div class="cb-d-flex cb-mt-4 gap-2">
    {link("Edit",
      to: Routes.event_path(@conn, :edit, @event),
      class: "cb-btn cb-btn-outline-secondary cb-rounded"
    )}
    {link("Back", to: "/admin/events", class: "cb-btn cb-btn-link cb-text cb-ml-auto")}
  </div>
</div>
