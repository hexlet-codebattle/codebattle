          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "opponent"
                ],
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "elementary",
                      "easy",
                      "medium",
                      "hard"
                    ]
                  },
                  "opponent": {
                    "type": "string",
                    "enum": [
                      "bot",
                      "link"
                    ]
                  },
                  "timeout_seconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 3600,
                    "default": 600
                  }
                }
              }
            }
          }
        },
        "description": "`opponent: bot` starts the game immediately against Codebot. `opponent: link` creates a hidden game waiting for an opponent; send them `join_url`. You can have only one active game at a time. Quota: 5 games per minute, 30 per day."
