{
  "openapi": "3.1.0",
  "info": {
    "title": "Codebattle Public API",
    "version": "1.0.0",
    "description": "Narrow, me-centric API for bots, CLIs and devices. Every request needs a personal token (Settings → API tokens): `Authorization: Bearer cbp_...`. Objects you are not related to answer 404. Limits are per user: 60 requests/min, 5 games/min and 30/day, 5 tournaments/day, at most 3 unfinished API-created tournaments. In v1 only additive changes happen. Human and LLM-friendly docs: https://codebattle.hexlet.io/api-docs (Markdown: /api-docs.md)."
  },
  "servers": [
    {
      "url": "https://codebattle.hexlet.io/public_api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scopes: read, games:write, tournaments:write"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "invalid_token",
                  "insufficient_scope",
                  "not_found",
                  "unsupported_media_type",
                  "validation_failed",
                  "quota_exceeded",
                  "rate_limited",
                  "api_disabled"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        },
        "example": {
          "error": {
            "code": "not_found",
            "message": "Not found"
          }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "rating": {
            "type": "integer"
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ]
          },
          "lang": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "example": {
          "id": 42,
          "name": "ada",
          "avatar_url": "https://avatars.githubusercontent.com/u/1?v=4",
          "rating": 1461,
          "rank": 12,
          "lang": "dlang"
        }
      },
      "GamePlayer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "rating": {
            "type": [
              "integer",
              "null"
            ]
          },
          "lang": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_bot": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "result": {
            "type": "string"
          },
          "result_percent": {
            "type": [
              "number",
              "null"
            ],
            "description": "Hidden for opponents while the game is live"
          }
        },
        "example": {
          "id": 42,
          "name": "ada",
          "avatar_url": null,
          "rating": 1461,
          "lang": "python",
          "is_bot": false,
          "result": "won",
          "result_percent": 100.0
        }
      },
      "Game": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "example": "https://codebattle.hexlet.io/games/324274"
          },
          "state": {
            "type": "string",
            "enum": [
              "waiting_opponent",
              "playing",
              "game_over",
              "timeout",
              "canceled"
            ]
          },
          "level": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "starts_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "timeout_seconds": {
            "type": "integer"
          },
          "ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "starts_at + timeout_seconds: when the game times out"
          },
          "finishes_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "tournament_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "task": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "level": {
                "type": "string"
              }
            }
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GamePlayer"
            }
          }
        },
        "example": {
          "id": 324274,
          "url": "https://codebattle.hexlet.io/games/324274",
          "state": "game_over",
          "level": "easy",
          "type": "duo",
          "starts_at": "2026-10-10T18:40:00Z",
          "timeout_seconds": 600,
          "ends_at": "2026-10-10T18:50:00Z",
          "finishes_at": "2026-10-10T18:46:12Z",
          "tournament_id": null,
          "task": {
            "id": 1201,
            "name": "pair_with_maximum_product",
            "level": "easy"
          },
          "players": [
            {
              "id": 42,
              "name": "ada",
              "avatar_url": null,
              "rating": 1461,
              "lang": "python",
              "is_bot": false,
              "result": "won",
              "result_percent": 100.0
            },
            {
              "id": -1,
              "name": "Codebot",
              "avatar_url": null,
              "rating": 1200,
              "lang": "js",
              "is_bot": true,
              "result": "lost",
              "result_percent": 40.0
            }
          ]
        }
      },
      "Tournament": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "upcoming",
              "waiting_participants",
              "active",
              "finished",
              "canceled",
              "timeout"
            ]
          },
          "level": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "description": "`open` for user tournaments; season grades for official ones"
          },
          "access_type": {
            "type": "string",
            "enum": [
              "public",
              "token"
            ]
          },
          "starts_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "players_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "players_limit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rounds_limit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "current_round": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "position": {
                "type": "integer"
              },
              "started_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "ends_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "break": {
            "type": "object",
            "properties": {
              "active": {
                "type": "boolean"
              },
              "ends_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "access_token": {
            "type": "string",
            "description": "Creator and moderators only"
          },
          "invite_url": {
            "type": "string",
            "description": "Creator and moderators only"
          }
        },
        "example": {
          "id": 5775,
          "name": "Friday practice",
          "url": "https://codebattle.hexlet.io/tournaments/5775",
          "type": "swiss",
          "state": "active",
          "level": "easy",
          "grade": "open",
          "access_type": "token",
          "starts_at": "2026-10-10T19:00:00Z",
          "started_at": "2026-10-10T19:00:04Z",
          "players_count": 8,
          "players_limit": 16,
          "rounds_limit": 3,
          "current_round": {
            "position": 1,
            "started_at": "2026-10-10T19:12:00Z",
            "ends_at": "2026-10-10T19:22:00Z"
          },
          "break": {
            "active": false,
            "ends_at": null
          },
          "access_token": "Xy7pQw2LmN4rTz8aB",
          "invite_url": "https://codebattle.hexlet.io/tournaments/5775?access_token=Xy7pQw2LmN4rTz8aB"
        }
      },
      "RankingEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "place": {
            "type": "integer"
          },
          "score": {
            "type": "number"
          },
          "lang": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "example": {
          "id": 42,
          "name": "ada",
          "place": 1,
          "score": 42,
          "lang": "python"
        }
      },
      "TournamentInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "example": "Friday practice"
          },
          "description": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "example": "Weekly practice for our team"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "In the future, at most 30 days ahead",
            "example": "2026-10-17T19:00:00Z"
          },
          "level": {
            "type": "string",
            "enum": [
              "elementary",
              "easy",
              "medium",
              "hard"
            ],
            "example": "easy"
          },
          "players_limit": {
            "type": "integer",
            "minimum": 2,
            "maximum": 64,
            "example": 16
          },
          "rounds_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "example": 3
          },
          "timeout_mode": {
            "type": "string",
            "enum": [
              "per_task",
              "per_round_fixed"
            ]
          },
          "match_timeout_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 3600
          },
          "round_timeout_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 3600
          },
          "break_duration_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600
          },
          "use_chat": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The token lacks the scope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found or not related to you",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit or quota exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "Invalid parameters; unknown fields are rejected",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The body is not sent as application/json",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "Current user",
        "security": [
          {
            "bearerAuth": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/Me"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "description": "Who the token belongs to. A cheap way to check that a token works."
      }
    },
    "/me/active_game": {
      "get": {
        "summary": "Current live game (null if none). Count down with ends_at - server_time.",
        "security": [
          {
            "bearerAuth": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "game": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/Game"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "server_time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "game": {
                    "id": 324274,
                    "url": "https://codebattle.hexlet.io/games/324274",
                    "state": "playing",
                    "level": "easy",
                    "type": "duo",
                    "starts_at": "2026-10-10T18:40:00Z",
                    "timeout_seconds": 600,
                    "ends_at": "2026-10-10T18:50:00Z",
                    "finishes_at": null,
                    "tournament_id": null,
                    "task": {
                      "id": 1201,
                      "name": "pair_with_maximum_product",
                      "level": "easy"
                    },
                    "players": [
                      {
                        "id": 42,
                        "name": "ada",
                        "avatar_url": null,
                        "rating": 1461,
                        "lang": "python",
                        "is_bot": false,
                        "result": "undefined",
                        "result_percent": 60.0
                      },
                      {
                        "id": -1,
                        "name": "Codebot",
                        "avatar_url": null,
                        "rating": 1200,
                        "lang": "js",
                        "is_bot": true,
                        "result": "undefined"
                      }
                    ]
                  },
                  "server_time": "2026-10-10T18:43:20Z"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "description": "The game you are playing right now, or `null`. Poll it (every few seconds is fine) to notice a game started from the web or by a tournament. Compute the remaining time as `ends_at - server_time`, not against your own clock."
      }
    },
    "/me/games": {
      "get": {
        "summary": "My finished games, newest first",
        "security": [
          {
            "bearerAuth": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "games": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Game"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "`next_cursor` from the previous page: returns games with a smaller id.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Only games started at or after this moment. ISO 8601 date (`2026-10-01`, midnight UTC) or datetime.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-01"
          },
          {
            "name": "to",
            "in": "query",
            "description": "Only games started before this moment. ISO 8601 date or datetime.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-10T18:00:00Z"
          }
        ],
        "description": "Finished games (`game_over` or `timeout`), 50 per page, newest first. Pagination is keyset-based: `next_cursor` is the id of the last game on the page; pass it back as `cursor` to get the next, older page. `next_cursor` is `null` on the last page. `from`/`to` narrow the result by game start time and combine with `cursor`."
      }
    },
    "/me/tournaments": {
      "get": {
        "summary": "Tournaments I created, moderate or play",
        "security": [
          {
            "bearerAuth": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tournaments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tournament"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by state, e.g. `active` or `finished`."
          }
        ],
        "description": "Up to 50 tournaments you created, moderate or joined as a player, newest first."
      }
    },
    "/tournaments/schedule": {
      "get": {
        "summary": "Public upcoming and active tournaments for the next 14 days",
        "security": [
          {
            "bearerAuth": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tournaments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tournament"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "description": "Public tournaments that start between 1 day ago and 14 days ahead and are not finished yet: what the lobby shows as upcoming. For everything running right now use `GET /tournaments/live`."
      }
    },
    "/tournaments/live": {
      "get": {
        "summary": "Tournaments running now or open for joining",
        "description": "Tournaments in `waiting_participants` or `active` state regardless of `starts_at`: all public ones plus private ones you created, moderate or play in. Newest first, at most 100.",
        "security": [
          {
            "bearerAuth": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tournaments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tournament"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/tournaments": {
      "post": {
        "summary": "Create a private tournament (always grade open, tasks by level)",
        "security": [
          {
            "bearerAuth": [
              "tournaments:write"
            ]
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tournament": {
                      "$ref": "#/components/schemas/Tournament"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
