  "scripts": {
    "watch": "pnpm run dev",
    "dev": "vite",
    "build": "vite build",
    "build:mem": "NODE_OPTIONS='--max-old-space-size=4096' pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test-watch": "vitest",
    "lint": "pnpm run lint-fix",
    "lint:js": "oxlint ./assets/js",
    "lint:scss": "stylelint \"assets/css/**/*.scss\"",
    "lint-fix": "pnpm run lint-fix:js && pnpm run lint-fix:scss",
    "lint-fix:js": "pnpm run format:js && (oxlint --fix ./assets/js || true)",
    "lint-fix:scss": "pnpm run format:scss && (stylelint --fix \"assets/css/**/*.scss\" || true)",
    "check": "pnpm run typecheck && pnpm run check:js && pnpm run check:scss",
    "check:js": "pnpm run format:check:js && pnpm run lint:js",
    "check:scss": "pnpm run format:check:scss && pnpm run lint:scss",
    "format": "pnpm run format:js && pnpm run format:scss",
    "format:js": "oxfmt \"assets/js/**/*.{js,jsx,ts,tsx}\"",
    "format:scss": "prettier --write \"assets/css/**/*.scss\"",
    "format:check": "pnpm run format:check:js && pnpm run format:check:scss",
    "format:check:js": "oxfmt --check \"assets/js/**/*.{js,jsx,ts,tsx}\"",
    "format:check:scss": "prettier --check \"assets/css/**/*.scss\"",
    "typecheck": "tsc --noEmit"
  },
