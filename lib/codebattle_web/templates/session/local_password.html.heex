<div class="bare">
  <%= if header = Codebattle.Customization.get("login_header") do %>
    <div class="bare-custom">{raw(header)}</div>
  <% end %>
  <%= if body = Codebattle.Customization.get("login_body") do %>
    <div class="bare-custom">{raw(body)}</div>
  <% end %>

  <form method="post" action="/games/training">
    <input type="hidden" name="_csrf_token" value={csrf_token()} />
    <button type="submit" class="bare-btn">{gettext("Try simple battle")}</button>
  </form>

  <div class="bare-card">
    <%= form_for @conn, Routes.session_path(@conn, :create), [as: :session], fn f -> %>
      <div class="bare-field">
        {label(f, :name, gettext("Name"))}
        {text_input(f, :name,
          placeholder: gettext("Enter your name"),
          autocomplete: "username",
          required: true
        )}
      </div>
      <div class="bare-field">
        {label(f, :password, gettext("Password"))}
        {password_input(f, :password,
          placeholder: gettext("Enter your password"),
          autocomplete: "current-password",
          required: true
        )}
      </div>
      {submit(gettext("Log in"), class: "bare-btn bare-btn--primary")}
    <% end %>
  </div>
</div>
