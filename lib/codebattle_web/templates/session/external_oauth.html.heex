<% external = Application.get_env(:codebattle, :external, []) %>
<div class="ext">
  <div class="ext-cup"></div>
  <div id="externalBackGround" class="rotating-background"></div>
  <div class="ext-card">
    <div class="ext-name">{external[:app_name]}</div>
    <h1 class="ext-slogan">{raw(external[:app_slogan])}</h1>
    <div class="ext-description">{external[:app_login_description]}</div>
    <%!-- The login itself is wired by the admin-provided external_oauth_body. --%>
    <button class="ext-btn" id="externalLoginBtn">{external[:app_login_button]}</button>
  </div>
</div>

<%= if body = Codebattle.Customization.get("external_oauth_body") do %>
  <div>{raw(body)}</div>
<% end %>
