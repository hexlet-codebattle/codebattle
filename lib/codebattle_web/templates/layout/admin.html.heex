<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link rel="icon" href="/assets/images/favicons/favicon.svg" type="image/svg+xml" />
    <% meta_tags = Map.put_new(assigns[:meta_tags] || %{}, :title, "Codebattle Admin") %>
    {render_tags_all(page_meta_tags(@conn, %{meta_tags: meta_tags}))}
    <meta name="csrf-token" content={csrf_token_value()} />

    <%= if CodebattleWeb.Vite.dev?() do %>
      <script type="module" src={"#{CodebattleWeb.Frontend.dev_server_url()}/@vite/client"}>
      </script>
      <script
        type="module"
        src={"#{CodebattleWeb.Frontend.dev_server_url()}/#{CodebattleWeb.Frontend.admin_entry_path()}"}
      >
      </script>
    <% else %>
      <% admin_assets = CodebattleWeb.Frontend.assets(CodebattleWeb.Frontend.admin_entry_path()) %>
      <%= for href <- admin_assets.css do %>
        <link rel="stylesheet" href={href} />
      <% end %>
      <script :if={admin_assets.js} type="module" src={admin_assets.js}>
      </script>
    <% end %>
  </head>
  <body class="admin-body">
    <a class="admin-skip-link" href="#admin-main">Skip to content</a>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
          <a class="admin-brand" href="/admin" aria-label="Codebattle admin overview">
            <img src="/assets/images/favicons/favicon.svg" alt="" width="30" height="30" />
            <span>Codebattle <small>Admin</small></span>
          </a>
          <button
            id="admin-sidebar-toggle"
            class="admin-sidebar-toggle"
            type="button"
            aria-controls="admin-sidebar-content"
            aria-expanded="true"
            hidden
          >
            <span class="admin-toggle-mobile">Menu</span>
            <span class="admin-toggle-desktop" aria-hidden="true">‹</span>
          </button>
        </div>
        <% admin_user = @conn.assigns[:current_user] %>
        <div id="admin-sidebar-content" class="admin-sidebar-content">
          <nav aria-label="Administration">
            <div :for={{group, links} <- admin_navigation()} class="admin-nav-group">
              <p :if={group} class="admin-nav-title">{group}</p>
              <a
                :for={{label, path, short} <- links}
                href={path}
                class="admin-nav-link"
                aria-current={admin_nav_current(@conn.request_path, path)}
                aria-label={label}
                title={label}
              >
                <span class="admin-nav-short" aria-hidden="true">{short}</span>
                <span class="admin-nav-label">{label}</span>
              </a>
            </div>
          </nav>
          <div class="admin-sidebar-footer">
            <a
              href="/"
              class="admin-nav-link"
              aria-label="Back to Codebattle"
              title="Back to Codebattle"
            >
              <span class="admin-nav-short admin-nav-back" aria-hidden="true"></span>
              <span class="admin-nav-label">Back to Codebattle</span>
            </a>
            <div :if={admin_user} class="admin-user">
              <div class="admin-user-name">{admin_user.name}</div>
              <small>Admin account · #{admin_user.id}</small>
            </div>
          </div>
        </div>
      </aside>
      <main id="admin-main" class="admin-main" tabindex="-1">
        {@inner_content}
      </main>
    </div>
  </body>
</html>
