<!DOCTYPE html>
<%!-- The server-rendered page layout (no app bundle): error pages and the screens that
     embed admin-provided HTML (maintenance / waiting / authorized, the external-OAuth and
     local-password sign-in variants). Every Inertia page uses v2.html instead. --%>
<html lang={Gettext.get_locale(CodebattleWeb.Gettext)}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    {google_fonts_head()}
    <link
      href="/assets/images/favicons/favicon-32x32.png?v=codebattle-logo"
      rel="icon"
      sizes="32x32"
      type="image/png"
    />
    <link
      href="/assets/images/favicons/favicon.svg?v=codebattle-logo"
      rel="icon"
      sizes="any"
      type="image/svg+xml"
    />
    <link href="/assets/images/favicons/favicon.ico?v=codebattle-logo" rel="shortcut icon" />
    {render_tags_all(assigns[:meta_tags] || %{})}
    <meta name="csrf-token" content={csrf_token_value()} />
    <title>{Application.get_env(:codebattle, :app_title)}</title>
    {render("_server_styles.html", assigns)}
  </head>
  <body>
    <%= for {kind, message} <- Phoenix.Flash.get(assigns[:flash] || %{}, :danger) |> List.wrap() |> Enum.map(&{"danger", &1}) |> Kernel.++(Enum.map(List.wrap(Phoenix.Flash.get(assigns[:flash] || %{}, :info)), &{"info", &1})) do %>
      <div class={"bare-flash bare-flash--#{kind}"} style="margin: 16px auto 0;" role="alert">
        {message}
      </div>
    <% end %>
    {@inner_content}
  </body>
</html>
