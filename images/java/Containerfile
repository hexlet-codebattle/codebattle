ARG RUNNER_IMAGE=ghcr.io/hexlet-codebattle/runner-zig:latest
ARG CORRETTO_TAG=27-alpine3.24-full
ARG TARGETPLATFORM

FROM --platform=$TARGETPLATFORM ${RUNNER_IMAGE} AS runner
FROM --platform=$TARGETPLATFORM amazoncorretto:${CORRETTO_TAG}


# Java has a separate trust store. Remove the incident's trust anchors even
# when an existing Corretto tag still contains its older bundled certificates.
RUN keytool -list -v -cacerts -storepass changeit > /tmp/java-certs \
  && awk '/^Alias name: / {alias=substr($0,13)} \
    /SHA256:/ {gsub(":", "", $2); \
      if ($2 == "7DD78D5F4F13459A83DFF9ABBBA62EDBAF6F2D102BF257FD712F4D9F2746ED8D" || \
          $2 == "D7A7A0FB5D7E2731D771E9484EBCDEF71D5F0C3E0A2948782BC83EE0EA699EF4" || \
          $2 == "86A1ECBA089C4A8D3BBE2734C612BA341D813E043CF9E8A862CD5C57A36BBE6B") print alias}' \
    /tmp/java-certs > /tmp/distrusted-aliases \
  && while IFS= read -r alias; do \
    keytool -delete -cacerts -storepass changeit -alias "$alias" || exit 1; \
  done < /tmp/distrusted-aliases \
  && rm /tmp/java-certs /tmp/distrusted-aliases

RUN apk add "ca-certificates>=20261020-r0" --update --no-cache make curl

# app user
RUN addgroup -S app -g 10001 \
  && adduser -S -D -H -h /nonexistent -s /sbin/nologin -G app -u 10001 app

WORKDIR /usr/src/app

RUN curl -L -o gson.jar https://repo1.maven.org/maven2/com/google/code/gson/gson/2.14.0/gson-2.14.0.jar \
  && chown -R app:app /usr/src/app

COPY check check
COPY Makefile .
RUN chown -R app:app /usr/src/app

USER app

EXPOSE 4040
COPY --from=runner /app/codebattle_runner /runner/codebattle_runner
ENTRYPOINT ["/runner/codebattle_runner"]
