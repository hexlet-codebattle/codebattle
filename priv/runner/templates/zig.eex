const std = @import("std");
const solution = @import("solution.zig");

const posix = std.posix;
const Io = std.Io;

const Pipe = struct { r: posix.fd_t, w: posix.fd_t };

// Zig 0.16+ dropped the std.posix pipe/dup wrappers; posix.system is the raw
// syscall layer (linux) or libc (darwin).
fn sysFd(rc: anytype) !posix.fd_t {
    if (posix.errno(rc) != .SUCCESS) return error.Syscall;
    return @intCast(rc);
}

fn pipeOpen() !Pipe {
    var fds: [2]posix.fd_t = undefined;
    _ = try sysFd(posix.system.pipe(&fds));
    return .{ .r = fds[0], .w = fds[1] };
}

fn closeFd(fd: posix.fd_t) void {
    _ = posix.system.close(fd);
}

fn secondsBetween(t0: Io.Timestamp, t1: Io.Timestamp) f64 {
    const ns = t0.durationTo(t1).nanoseconds;
    return @as(f64, @floatFromInt(ns)) / @as(f64, @floatFromInt(std.time.ns_per_s));
}

fn writeJson(outw: anytype, value: anytype) !void {
    try outw.print("{f}", .{std.json.fmt(value, .{})});
}

pub fn main(init: std.process.Init) !void {
    const io = init.io;
    const gpa = init.gpa;
    const stdout_fd = posix.STDOUT_FILENO;
    var stdout_buf: [4096]u8 = undefined;
    var stdout_writer = Io.File.stdout().writer(io, &stdout_buf);
    const outw = &stdout_writer.interface;

    // Begin JSON array
    try outw.writeByte('[');
    var first = true;

    <%= for %{arguments: arguments} <- checks do %>
    {
        if (!first) try outw.writeByte(',') else first = false;

        <%= for %{defining: defining, value: value} <- arguments.info do %>
        const <%= defining %> = <%= value %>;
        <% end %>

        const maybe_p = pipeOpen() catch null;

        if (maybe_p) |p| {
            // duplicate stdout and redirect
            const saved = try sysFd(posix.system.dup(stdout_fd));
            defer closeFd(saved);

            _ = try sysFd(posix.system.dup2(p.w, stdout_fd));

            const t0 = Io.Timestamp.now(io, .awake);
            const val = solution.solution(<%= arguments.expression %>);
            const t1 = Io.Timestamp.now(io, .awake);

            // restore stdout
            _ = try sysFd(posix.system.dup2(saved, stdout_fd));
            closeFd(p.w);

            // read captured output
            const rfile: Io.File = .{ .handle = p.r, .flags = .{ .nonblocking = false } };
            defer rfile.close(io);
            var rbuf: [4096]u8 = undefined;
            var rreader = rfile.reader(io, &rbuf);

            const out_slice = try rreader.interface.allocRemaining(gpa, .limited(1 << 20)); // 1 MiB
            defer gpa.free(out_slice);

            const secs = secondsBetween(t0, t1);

            // emit JSON object
            try outw.writeAll("{\"type\":\"result\",\"value\":");
            try writeJson(outw, val);
            try outw.writeAll(",\"time\":");
            try writeJson(outw, secs);
            try outw.writeAll(",\"output\":");
            try writeJson(outw, @as([]const u8, out_slice));
            try outw.writeByte('}');
        } else {
            // No-capture fallback
            const t0 = Io.Timestamp.now(io, .awake);
            const val = solution.solution(<%= arguments.expression %>);
            const t1 = Io.Timestamp.now(io, .awake);
            const secs = secondsBetween(t0, t1);

            try outw.writeAll("{\"type\":\"result\",\"value\":");
            try writeJson(outw, val);
            try outw.writeAll(",\"time\":");
            try writeJson(outw, secs);
            try outw.writeAll(",\"output\":\"\"}");
        }
    }
    <% end %>

    // End JSON array
    try outw.writeByte(']');
    try outw.flush();
}
