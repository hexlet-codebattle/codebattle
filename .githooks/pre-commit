#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

JS_PREFIX="apps/codebattle/frontend/src/"
APP_DIR="apps/codebattle/frontend"
APP_PREFIX="apps/codebattle/frontend/"
ELIXIR_PATTERN='(^mix\.exs$|^\.formatter\.exs$|^config/.*\.exs$|.*\.(ex|exs)$)'

JS_STAGED_FILES=()
while IFS= read -r file; do
  JS_STAGED_FILES+=("$file")
done < <(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E "^${JS_PREFIX}.*\\.(js|jsx|ts|tsx)$" || true
)

ELIXIR_STAGED_FILES=()
while IFS= read -r file; do
  ELIXIR_STAGED_FILES+=("$file")
done < <(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E "${ELIXIR_PATTERN}" || true
)

if [ "${#JS_STAGED_FILES[@]}" -eq 0 ] && [ "${#ELIXIR_STAGED_FILES[@]}" -eq 0 ]; then
  exit 0
fi

if [ "${#ELIXIR_STAGED_FILES[@]}" -gt 0 ]; then
  ./bin/dev mix format "${ELIXIR_STAGED_FILES[@]}"
  git add -- "${ELIXIR_STAGED_FILES[@]}"
  ./bin/dev mix credo --strict
fi

if [ "${#JS_STAGED_FILES[@]}" -gt 0 ]; then
  JS_APP_FILES=()
  for file in "${JS_STAGED_FILES[@]}"; do
    JS_APP_FILES+=("${file#${APP_PREFIX}}")
  done

  ./bin/dev pnpm --dir "$APP_DIR" exec oxlint --fix "${JS_APP_FILES[@]}" || true
  git add -- "${JS_STAGED_FILES[@]}"
fi
