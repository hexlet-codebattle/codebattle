# The frontend: its own package and Vite build.
FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS frontend-image

# Mirrors the repo layout: the app imports translations and tournament templates from ../priv.
WORKDIR /tmp/codebattle/frontend

RUN npm install --global pnpm@11.18.0

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY priv/gettext ../priv/gettext
COPY priv/tournament_templates.json ../priv/tournament_templates.json
COPY frontend ./
RUN pnpm run build

FROM elixir:1.20.5-otp-29-alpine@sha256:a2f0fe1bfd8a2f9cc91d913f4a12e6430e27e618720f753a514e2fff3d35f5a7 AS compile-image
ENV MIX_ENV=prod

WORKDIR /opt/app

RUN apk update && apk add --no-cache build-base git "ca-certificates>=20261020-r0" make curl brotli gzip \
  && mix local.hex --force \
  && mix local.rebar --force

COPY mix.exs .
COPY mix.lock .
COPY config ./config

RUN mix do deps.get --only prod, deps.compile

COPY lib ./lib
COPY priv ./priv
COPY static ./static

# Static files (images, audio, fonts, favicons) at /assets/*; the PWA worker and its
# offline page at the root.
RUN mkdir -p priv/static/assets \
  && cp -R static/. priv/static/assets/ \
  && mv priv/static/assets/offline.html priv/static/assets/service-worker.js priv/static/
# phx.digest only for what is looked up through the cache manifest: the static files
# (CodebattleWeb.Vite.static_asset_path) and Vite's manifest, whose digest is Inertia's
# asset version. Vite fingerprints its own files, so digesting them would only add
# unused copies.
COPY --from=frontend-image /tmp/codebattle/frontend/dist/manifest.json ./priv/static/assets/v2/manifest.json
RUN mix phx.digest

# Served at /assets/v2 by nginx and Phoenix (see CodebattleWeb.Frontend).
COPY --from=frontend-image /tmp/codebattle/frontend/dist ./priv/static/assets/v2

# Add .br for every compressible file (and .gz where phx.digest did not write one)
# so nginx can serve precompressed variants via brotli_static/gzip_static.
RUN find priv/static/assets -type f \( \
    -name "*.js" -o -name "*.mjs" -o -name "*.css" -o -name "*.html" -o \
    -name "*.json" -o -name "*.map" -o -name "*.svg" -o -name "*.txt" -o \
    -name "*.xml" -o -name "*.csv" -o -name "*.ico" -o -name "*.ttf" -o \
    -name "*.otf" -o -name "*.eot" -o -name "*.wasm" \
  \) -print0 \
  | xargs -0 -r -P "$(nproc)" -n 16 sh -c \
    'for f; do brotli -f -q 11 "$f"; [ -f "$f.gz" ] || gzip -k -9 "$f"; done' _ \
  && mix release codebattle \
  && mv _build/prod/rel/codebattle /opt/release

# Same Alpine release as the Elixir image.
FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS nginx-assets

RUN apk add --no-cache nginx nginx-mod-http-brotli

COPY nginx.conf /etc/nginx/http.d/default.conf
COPY nginx-assets-entrypoint.sh /opt/nginx-assets-entrypoint.sh

COPY --from=compile-image /opt/release/lib/codebattle-0.1.0/priv/static/assets/ /var/www/assets

RUN nginx -t

RUN chmod +x /opt/nginx-assets-entrypoint.sh

CMD ["/opt/nginx-assets-entrypoint.sh"]

FROM elixir:1.20.5-otp-29-alpine@sha256:a2f0fe1bfd8a2f9cc91d913f4a12e6430e27e618720f753a514e2fff3d35f5a7 AS runtime-image

RUN apk add --no-cache "ca-certificates>=20261020-r0" chromium git make curl vim

ARG GIT_HASH

ENV APP_VERSION=$GIT_HASH
ENV PORT=4000
ENV MIX_ENV=prod
EXPOSE ${PORT}
WORKDIR /opt/app
COPY --from=compile-image /opt/release .
COPY Makefile Makefile
CMD ["/opt/app/bin/codebattle", "start"]
